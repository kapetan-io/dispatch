#!/usr/bin/env bash
# dispatch-ticket-hint — SessionStart hook. When the session's repo, or the
# clone a worktree belongs to, is listed under [repos] in the dispatch config,
# tell the agent to load dispatch:ticket before filing a ticket. With a long
# skill list Claude Code shows some skills by name only (seen with 96 skills on
# 2026-10-09), so the skill's description alone cannot make it fire.
set -uo pipefail

config="${DISPATCH_CONFIG:-$HOME/.config/dispatch/config.toml}"
[ -r "$config" ] || exit 0

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
clone=$(cd "$(dirname "$common")" 2>/dev/null && pwd -P) || exit 0

managed=$(tr -d '\r' <"$config" | awk '
  /^[ \t]*\[/ { h = $0; sub(/^[ \t]*/, "", h); sub(/[ \t]*(#.*)?$/, "", h); in_repos = (h == "[repos]"); next }
  /^[ \t]*#/ { next }
  in_repos && /=/ { sub(/^[^=]*=[ \t]*["\x27]/, ""); sub(/["\x27].*$/, ""); print }
')

while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in "~") path="$HOME" ;; "~/"*) path="$HOME/${path#\~/}" ;; esac
  resolved=$(cd "$path" 2>/dev/null && pwd -P) || continue
  if [ "$resolved" = "$clone" ]; then
    echo "This repo is managed by dispatch. Before you create or rewrite a Linear ticket, load the dispatch:ticket skill and use it instead of linear-create, whether the user asked for the ticket or you are filing it yourself."
    exit 0
  fi
done <<<"$managed"
