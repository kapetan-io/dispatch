#!/usr/bin/env bash
# dispatch-launch — lease a treehouse tree for a Linear ticket, open a herdr
# workspace on it, and start a Claude build worker running /dispatch:build.
# The dispatcher runs it from the repo's local clone; you can too.
#
#   dispatch-launch <TICKET> <BRANCH> [--base REF] [--model NAME] [--no-focus]
#
# Contract: exactly one JSON object on stdout, `status` field first; progress
# on stderr. Exit 0 iff status is ok or already_running. Statuses:
#   ok | already_running | not_pooled | pool_exhausted | pool_error |
#   herdr_unavailable | usage_error | not_a_repo | checkout_failed |
#   workspace_failed | agent_start_failed | injection_unconfirmed
#
# pool_exhausted is proven, never assumed: after a lease failure the script
# reads `treehouse status --json` and reports exhaustion only when no tree is
# available and the pool is at max_trees. Every other lease failure is
# pool_error, a fault to diagnose rather than a queue to wait in.
#
# Rewritten from captain-launch (skills/captain in ~/.claude). The herdr
# handling below keeps that script's fixes: nested worktree workspaces, an
# env-stamped tab, waiting for the shell before starting the agent, answering
# the consent and folder-trust dialogs, and confirming the kickoff landed.
set -uo pipefail

log() { echo "dispatch-launch: $*" >&2; }

# DISPATCH_LAUNCH_TRACE=<file> appends every screen the kickoff step reads.
trace() {
  [ -n "${DISPATCH_LAUNCH_TRACE:-}" ] || return 0
  printf '=== %s %s\n%s\n' "$(date +%T)" "$1" "$2" >>"$DISPATCH_LAUNCH_TRACE"
}

# finish <status> [key=value ...] — print the one JSON result and exit.
finish() {
  local status=$1; shift
  local jq_args=(--arg status "$status")
  local jq_obj='{status: $status'
  local kv k
  for kv in "$@"; do
    k=${kv%%=*}
    jq_args+=(--arg "$k" "${kv#*=}")
    jq_obj+=", $k: \$$k"
  done
  jq_obj+='}'
  jq -n "${jq_args[@]}" "$jq_obj"
  case $status in ok|already_running) exit 0 ;; esac
  exit 1
}

plugin_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# --- args --------------------------------------------------------------------
ticket=${1:-}; branch=${2:-}
shift 2 2>/dev/null || true
base=main model=sonnet
while [ $# -gt 0 ]; do
  case $1 in
    --base)  base=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --no-focus) shift ;;  # always on; accepted so callers can say it
    *) finish usage_error detail="unknown argument: $1" ;;
  esac
done
if [ -z "$ticket" ] || [ -z "$branch" ]; then
  log "usage: dispatch-launch <TICKET> <BRANCH> [--base REF] [--model NAME]"
  finish usage_error detail="TICKET and BRANCH are required"
fi
# The worker's herdr agent name is the lowercased ticket id, so a relaunch
# reclaims the same name. Claude itself is never given --name: it draws the
# name in a rule below an open question, and herdr then misses the question
# and reports the worker done instead of blocked.
worker_name=$(tr '[:upper:]' '[:lower:]' <<<"$ticket")
label="$ticket"
kickoff="/dispatch:build $ticket"

repo=$(git rev-parse --show-toplevel 2>/dev/null) ||
  finish not_a_repo detail="run from inside the target repo"
[ -f "$repo/treehouse.toml" ] ||
  finish not_pooled detail="$repo has no treehouse.toml. Workers only run on leased pool trees, so add one (treehouse init) before approving tickets in this repo."

# --- preflight ---------------------------------------------------------------
deadline=$(( $(date +%s) + ${DISPATCH_LAUNCH_PREFLIGHT_TIMEOUT:-60} ))
until herdr workspace list >/dev/null 2>&1; do
  if (( $(date +%s) >= deadline )); then
    finish herdr_unavailable detail="herdr server not answering"
  fi
  log "waiting for herdr server..."; sleep 5
done

# --- branch ------------------------------------------------------------------
git -C "$repo" fetch --no-tags origin "$branch" >/dev/null 2>&1
existed=0 fresh=0
if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
  existed=1
elif git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  git -C "$repo" branch --track "$branch" "origin/$branch" >/dev/null 2>&1
  existed=1
fi

# --- tree --------------------------------------------------------------------
# A tree already holding this ticket's lease is reused, so a relaunch resumes
# in place. A tree is never adopted just for having the branch checked out: it
# could be the user's own clone, or a pool tree treehouse may hand to someone
# else. If the branch is checked out elsewhere, the switch below fails loudly.
pool_json=$(cd "$repo" && treehouse status --json 2>/dev/null)
ck=$(jq -r --arg t "$ticket" '.[]? | select(.lease_holder==$t) | .path' <<<"$pool_json" 2>/dev/null | head -n1)
if [ -z "$ck" ]; then
  log "leasing a treehouse tree for $ticket"
  lease_err_file=$(mktemp)
  if ! lease_json=$(cd "$repo" && treehouse get --lease --lease-holder "$ticket" --json 2>"$lease_err_file") ||
      [ -z "$lease_json" ]; then
    lease_err=$(<"$lease_err_file"); rm -f "$lease_err_file"
    [ -n "$lease_err" ] && log "treehouse get: $lease_err"
    pool_json=$(cd "$repo" && treehouse status --json 2>/dev/null)
    max_trees=$(sed -nE 's/^max_trees *= *([0-9]+).*/\1/p' "$repo/treehouse.toml" | head -n1)
    total=$(jq 'length' <<<"$pool_json" 2>/dev/null)
    avail=$(jq '[.[] | select(.status=="available")] | length' <<<"$pool_json" 2>/dev/null)
    holders=$(jq -r '[.[] | select(.status!="available") | "\(.lease_holder // "?") (\(.status))"] | join(", ")' <<<"$pool_json" 2>/dev/null)
    if [ -n "$max_trees" ] && [ -n "$total" ] && [ "$avail" = 0 ] && [ "$total" -ge "$max_trees" ] 2>/dev/null; then
      finish pool_exhausted detail="all $total/$max_trees pool trees are taken: $holders"
    fi
    finish pool_error \
      detail="treehouse lease failed but the pool is not exhausted ($avail of $total available, max_trees=$max_trees; holders: $holders). treehouse stderr: $lease_err"
  fi
  rm -f "$lease_err_file"
  ck=$(jq -r '.path // empty' <<<"$lease_json" 2>/dev/null)
  [ -n "$ck" ] || finish pool_error detail="lease succeeded but treehouse JSON had no path: $lease_json"
  log "leased $ck"
  fresh=1
  co_ok=1
  if [ $existed -eq 1 ]; then
    git -C "$ck" switch "$branch" >&2 || co_ok=0
  else
    git -C "$repo" fetch --no-tags origin "$base" >/dev/null 2>&1
    git -C "$ck" switch --no-track -c "$branch" "origin/$base" >&2 ||
      git -C "$ck" switch -c "$branch" "$base" >&2 || co_ok=0
  fi
  if [ $co_ok -eq 0 ]; then
    log "checkout of $branch failed in leased tree, returning the lease"
    (cd "$repo" && treehouse return "$ck" --if-lease-holder "$ticket" --force >&2)
    finish checkout_failed detail="git switch to $branch failed in leased tree $ck (lease returned)"
  fi
fi

# give_back closes the workspace and returns the lease when this run took the
# lease, so a failed launch holds no pool slot. Any Claude in the workspace
# has not been given the kickoff yet, so closing it loses no work. A lease
# from an earlier run may hold a worker's uncommitted work, and --force would
# discard it, so that one is kept.
give_back() {
  [ "$fresh" = 1 ] || return 0
  # The lease goes back only after the workspace is confirmed closed. A tree
  # returned with its workspace still open would match that workspace by
  # path, so the next ticket to lease it would never start.
  if [ -n "${ws:-}" ] && ! herdr workspace close "$ws" >/dev/null 2>&1; then
    log "workspace $ws did not close, keeping the lease on $ck"
    return 0
  fi
  log "returning the lease on $ck"
  (cd "$repo" && treehouse return "$ck" --if-lease-holder "$ticket" --force >&2)
}

# --- workspace ---------------------------------------------------------------
ws=$(herdr workspace list 2>/dev/null \
     | jq -r --arg ck "$ck" '.result.workspaces[] | select(.worktree.checkout_path==$ck) | .workspace_id' \
     | head -n1)

if [ -n "$ws" ]; then
  running=$(herdr pane list 2>/dev/null \
            | jq -r --arg ws "$ws" '.result.panes[] | select(.workspace_id==$ws and .agent=="claude") | .pane_id' \
            | head -n1)
  if [ -n "$running" ]; then
    finish already_running detail="workspace $ws already has a Claude pane ($running); not typing a second kickoff" \
      workspace="$ws" pane="$running" worktree="$ck"
  fi
fi

# Open the checkout as a worktree so its workspace nests under the repo in
# herdr's sidebar. There is no bare-workspace fallback: herdr reports a bare
# workspace with no worktree path, so the dispatcher could never find its
# worker and would launch another one on every tick.
if [ -z "$ws" ]; then
  # herdr refuses a linked worktree as the source, so name the main checkout
  # even when the launcher runs from inside a pool tree.
  main_checkout=$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")
  opened=$(herdr worktree open --cwd "$main_checkout" --path "$ck" --label "$label" --no-focus --json 2>&1)
  ws=$(jq -r '.result.worktree.open_workspace_id // .result.workspace.workspace_id // empty' <<<"$opened" 2>/dev/null)
  [ -n "$ws" ] || { give_back; finish workspace_failed detail="herdr worktree open failed for $ck: $opened" worktree="$ck"; }
fi

# The worker's env. The shim dir carries a `claude` wrapper that re-adds the
# plugin and worker flags when herdr restarts it with a bare `claude --resume`,
# since herdr does not replay agent argv.
env_args=(
  --env "PATH=$plugin_root/scripts/shims:$PATH"
  --env "AUTONOMOUS_WORKER=1"
  --env "DISPATCH_PLUGIN_ROOT=$plugin_root"
)

# worktree open carries no --env, but tab create does, so the worker runs in a
# fresh stamped tab and the agent-less tabs the workspace opened with are
# closed.
created=$(herdr tab create --workspace "$ws" --cwd "$ck" --label "$label" "${env_args[@]}" --no-focus 2>&1)
pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created" 2>/dev/null)
[ -n "$pane" ] || { give_back; finish workspace_failed detail="herdr tab create failed in $ws: $created" workspace="$ws" worktree="$ck"; }
while read -r tid; do
  [ -n "$tid" ] && herdr tab close "$tid" >/dev/null 2>&1
done < <(herdr pane list 2>/dev/null \
         | jq -r --arg ws "$ws" --arg p "$pane" \
             '.result.panes[] | select(.workspace_id==$ws and .pane_id!=$p and ((.agent // "")=="")) | .tab_id' \
         | sort -u)

# --- agent -------------------------------------------------------------------
agent_name=$worker_name
start_agent() {
  if herdr agent list 2>/dev/null | jq -e --arg n "$agent_name" '.result.agents[] | select(.name==$n)' >/dev/null 2>&1; then
    agent_name="$worker_name-r$RANDOM"
  fi
  # A fresh pane rejects agent start until its shell has drawn a prompt.
  local try
  for try in $(seq 15); do
    herdr pane read "$pane" 2>/dev/null | grep -qE '[>❯$%]' && break
    log "pane $pane shell not ready yet ($try/15)"
    sleep 1
  done
  local out
  out=$(herdr agent start "$agent_name" --kind claude --pane "$pane" --timeout 90000 -- \
        --model "$model" --plugin-dir "$plugin_root" \
        --disallowedTools "EnterPlanMode,ExitPlanMode" --dangerously-skip-permissions 2>&1) || {
    log "agent start failed: $out"
    return 1
  }
}
# A timed-out start may still bring Claude up, so retry only into a pane that
# has no Claude agent.
pane_has_claude() {
  herdr agent list 2>/dev/null | jq -e --arg p "$pane" '.result.agents[] | select(.pane_id==$p and .agent=="claude")' >/dev/null 2>&1
}
start_agent || { sleep 3; pane_has_claude || start_agent; } || pane_has_claude || { give_back; finish agent_start_failed \
  detail="herdr agent start failed in pane $pane" workspace="$ws" pane="$pane" worktree="$ck"; }

# --- kickoff -----------------------------------------------------------------
# A submitted kickoff is confirmed by herdr's agent status leaving idle, never
# by finding its text on screen: while a skill runs, Claude's screen shows only
# the spinner and an empty input box, and a text probe misread that as a lost
# kickoff and typed it again. The kickoff is retyped only while the agent is
# still idle with the text gone from its input box.
probe=${kickoff:0:24}
inject() {  # 0 = landed, 1 = unconfirmed
  local screen status consent_try=0 ready=0 try
  herdr agent wait "$pane" --until idle --timeout 15000 >/dev/null 2>&1
  for _ in $(seq 30); do
    screen=$(herdr agent read "$pane" --source visible --lines 30 2>/dev/null | tr '\n' ' ')
    trace "dialogs" "$screen"
    # One-time bypass-permissions consent. Match the option text, never
    # "bypass permissions", which the status line shows forever after.
    if grep -qiF 'yes, i accept' <<<"$screen"; then
      if (( consent_try % 2 == 0 )); then
        herdr pane send-keys "$pane" Down Enter >/dev/null 2>&1
      else
        herdr pane send-keys "$pane" 2 >/dev/null 2>&1
        herdr pane send-keys "$pane" Enter >/dev/null 2>&1
      fi
      consent_try=$((consent_try + 1)); sleep 1; continue
    fi
    # First-run folder trust. The cursor may default to "No, exit".
    if grep -qiE 'trust this folder' <<<"$screen"; then
      grep -qiE '❯ *(no|don.t)' <<<"$screen" && herdr pane send-keys "$pane" Down >/dev/null 2>&1
      herdr pane send-keys "$pane" Enter >/dev/null 2>&1
      sleep 1; continue
    fi
    if grep -qF '❯' <<<"$screen"; then ready=1; break; fi
    sleep 1
  done
  [ $ready -eq 1 ] || return 1
  for try in 1 2 3; do
    trace "typing" "$kickoff (try $try)"
    herdr pane run "$pane" "$kickoff" >/dev/null 2>&1
    herdr pane send-keys "$pane" Enter >/dev/null 2>&1
    herdr agent wait "$pane" --until working --until blocked --timeout 15000 >/dev/null 2>&1 && return 0
    screen=$(herdr agent read "$pane" --source visible --lines 30 2>/dev/null | tr '\n' ' ')
    trace "not-working" "$screen"
    # Retype only while the agent sits idle. done means a fast kickoff already
    # ran, and working or blocked means it is running, so never type it again.
    status=$(herdr agent list 2>/dev/null \
      | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id==$p) | .agent_status' | head -n1)
    case $status in
      idle) ;;
      working|blocked|done) return 0 ;;
      *) return 1 ;;
    esac
    # Typed but never submitted: press Enter rather than type it twice.
    if grep -qF "$probe" <<<"$screen"; then
      herdr pane send-keys "$pane" Enter >/dev/null 2>&1
      herdr agent wait "$pane" --until working --until blocked --timeout 15000 >/dev/null 2>&1 && return 0
      return 1
    fi
  done
  return 1
}
# An unconfirmed kickoff closes the workspace. Left open, its idle Claude
# would look like a live worker, and no tick would retry or escalate.
if ! inject; then
  herdr workspace close "$ws" >/dev/null 2>&1
  finish injection_unconfirmed \
    detail="Claude started but herdr never showed the kickoff running, so the workspace was closed and the next tick retries. Set DISPATCH_LAUNCH_TRACE=<file> to record the screens." \
    workspace="$ws" pane="$pane" worktree="$ck"
fi

finish ok ticket="$ticket" branch="$branch" worktree="$ck" workspace="$ws" \
  pane="$pane" agent="$agent_name" kickoff="$kickoff"
