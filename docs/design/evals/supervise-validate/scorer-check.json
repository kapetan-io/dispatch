{
  "patterns": {
    "told": "^(?![\\s\\S]*(?:go test(?:\\s+(?!-run)-\\S+(?:\\s+'[^']*'|\\s+[^\\s-]\\S*)?)*\\s+\\./\\S*|go test(?:\\s+-\\S+(?:\\s+'[^']*'|\\s+[^\\s-]\\S*)?)*\\s+\\./\\.\\.\\.))[\\s\\S]*go test(?=(?:(?!\\\\n)[^;&|])*-count=1)(?=(?:(?!\\\\n)[^;&|])*-run(?:=\\S+|\\s+(?:'[^']*'|\\\\\"[^\\\\]*\\\\\"|[^\\s'\"\\\\\\-./]\\S*))(?:(?!\\\\n)[^;&|])*\\./[\\w<])",
    "full": "go test(?!(?:(?!\\\\n)[^;&|])*-run)|go test(?:(?!\\\\n)[^;&|])*\\./\\.\\.\\."
  },
  "previous": {
    "told": "go test(?=[^\\n]*-count=1)(?=[^\\n]*-run)(?=[^\\n]*\\./[\\w<])",
    "full": "go test(?![^\\n;&|]*-run)|go test[^\\n;&|]*\\./\\.\\.\\."
  },
